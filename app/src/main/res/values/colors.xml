<resources>
    <!--
      The launcher icon takes its paint from the wallpaper, like every other
      surface in the app. These are the platform's own dynamic palette, public
      since API 31, and minSdk is 31, so there is no fallback to maintain.
      A themed icon ignores them and tints the silhouette instead.

      The feather runs from a light base to a deep tip of the accent, on a
      background barely tinted with it, so the relief reads as on paper.
    -->
    <color name="ic_launcher_background">@android:color/system_accent1_50</color>
    <color name="ic_feather_base">@android:color/system_accent1_100</color>
    <color name="ic_feather_middle">@android:color/system_accent1_300</color>
    <color name="ic_feather_tip">@android:color/system_accent1_600</color>
    <color name="ic_feather_shaft">@android:color/system_accent1_300</color>
</resources>
